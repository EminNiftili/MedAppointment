{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Dayaq Server API",
    "description": "MedAppointment API (`api/[controller]` routes). Set `baseUrl` (e.g. `http://localhost:5066` or `https://localhost:7022`). Collection `accessToken` is filled automatically from successful **Login — Traditional** / **Refresh** responses (test script). Bearer auth applies to requests that do not override auth to **No Auth**.\n\nPOST/PUT bodies use **example JSON** aligned with `MedAppointment.DataTransferObjects` (camelCase). Replace IDs, keys, and foreign keys with values that exist in your database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5066" },
    { "key": "accessToken", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
